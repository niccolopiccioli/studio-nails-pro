# Copia in .env e compila i valori.
# URL e chiave anonima: Supabase Dashboard → Project Settings → API.
SUPABASE_URL="https://senotpktlgabbgvauaul.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://senotpktlgabbgvauaul.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# OBBLIGATORIA per il server (prenotazioni pubbliche, bootstrap staff).
# Supabase Dashboard → Project Settings → API → Secret API key (sb_secret_...).
# Senza questa chiave le server function danno errore in locale.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Solo per `drizzle-kit push/migrate` (mai nel client).
# Supabase Dashboard → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres:[password]@db.senotpktlgabbgvauaul.supabase.co:5432/postgres"

# SOLA notifica del piano free: email di conferma prenotazione (via Resend).
# Se assenti, la prenotazione funziona lo stesso ma nessuna email viene inviata.
RESEND_API_KEY="re_..."
EMAIL_FROM="Studio Nails <noreply@example.com>"
# URL pubblico dell'app, usato per il link gestisci-appuntamento nell'email.
APP_URL="https://example.com"

# MULTISITO: stesso backend, un deploy per sito.
# Slug dello studio servito da questo deploy (tabella studios). Senza: studio storico.
STUDIO_SLUG="studio-nails"
# Tema: nails (default) oppure estetica. Vedi [data-theme] in src/styles.css.
VITE_THEME="nails"
# Brand del sito (default: Studio Nails). Il resto dei contenuti viene dal DB.
VITE_BRAND_NAME="Studio Nails"
VITE_BRAND_TAGLINE="Nail art su misura"
VITE_BRAND_DESC="Atelier di nail art a Milano: manicure, gel e nail art su misura."
VITE_BRAND_EYEBROW="Milano · Atelier su appuntamento"
VITE_BRAND_HERO_1="La cura"
VITE_BRAND_HERO_2="delle mani,"
VITE_BRAND_HERO_3="come un rituale."
VITE_BRAND_CTA_1="Le tue mani"
VITE_BRAND_CTA_2="se lo meritano."
VITE_BRAND_RATING="4.9 · 300+ recensioni"
VITE_BRAND_BADGE_K="Da oltre 8 anni"
VITE_BRAND_BADGE_V="+1.200 clienti"
# Didascalie portfolio separate da virgola (max 4). Foto: per ora condivise, shoot dedicato come step futuro.
VITE_BRAND_WORK_LABELS="Nude couture,Rosé minimal,Dettagli oro,French moderno"

