# Copia in .env e compila i valori.
# URL e chiave anonima: Supabase Dashboard → Project Settings → API.
SUPABASE_URL="https://senotpktlgabbgvauaul.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://senotpktlgabbgvauaul.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# OBBLIGATORIA per il server (prenotazioni pubbliche, bootstrap staff).
# Supabase Dashboard → Project Settings → API → Secret API key (sb_secret_...).
# Senza questa chiave le server function danno errore in locale.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Solo per `drizzle-kit push/migrate` (mai nel client).
# Supabase Dashboard → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres:[password]@db.senotpktlgabbgvauaul.supabase.co:5432/postgres"

# SOLA notifica del piano free: email di conferma prenotazione (via EmailJS).
# Se assenti, la prenotazione funziona lo stesso ma nessuna email viene inviata.
# Dashboard EmailJS: collega un Email Service, crea un template con "To Email"
# = {{to_email}} e variabili {{client_name}} {{service_name}} {{studio_name}}
# {{when}} {{manage_url}} {{privacy_url}}, poi incolla qui le 4 chiavi
# (Account → General → Public Key / Private Key).
EMAILJS_SERVICE_ID="service_..."
EMAILJS_TEMPLATE_ID="template_..."
EMAILJS_PUBLIC_KEY="..."
EMAILJS_PRIVATE_KEY="..."
# URL pubblico dell'app, fallback per i link email quando manca l'host request.
APP_URL="https://example.com"

# MULTISITO: stesso backend, un deploy per sito. Tenant, tema e brand sono
# risolti a runtime (hostname → studios.domains/slug, theme/brand dal DB).
# Nessuna env per-sito: le uniche env su Vercel sono quelle condivise in
# vercel.json + SUPABASE_SERVICE_ROLE_KEY (+ RESEND_*) da dashboard.
# Solo sviluppo locale: STUDIO_SLUG forza uno studio (default: studio-nails).
STUDIO_SLUG="studio-nails"
